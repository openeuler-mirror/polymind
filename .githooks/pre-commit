#!/bin/bash
# PolyMind 仓库自带的 Git 提交钩子。
# 容器内由 .devcontainer 的 core.hooksPath=.githooks 启用（写在容器内的 ~/.gitconfig）；
# 宿主机启用方式：git config core.hooksPath .githooks
set -e

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "pre-commit not found. Install it first: pip install pre-commit" >&2
    exit 1
fi

# git 保证在仓库顶层执行 hook，无需再 cd 到仓库根
# 仅检查暂存区变更文件（全量检查：pre-commit run --all-files）
exec pre-commit run --config .pre-commit-config.yaml
